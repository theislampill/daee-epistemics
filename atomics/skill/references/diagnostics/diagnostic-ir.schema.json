{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill/references/diagnostics/diagnostic-ir.schema.json",
  "title": "Diagnostic IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_family",
    "claim_type",
    "claim_level",
    "pattern_profile",
    "deformation",
    "concealment_mode",
    "do_orient",
    "read_status",
    "confidence",
    "alignment_state",
    "recognition_strength",
    "continuation_eligibility",
    "p7_stops_active",
    "reason_category",
    "routing_gate",
    "matched_modules",
    "restoration_target",
    "next_move",
    "output_shape",
    "post_render_gate"
  ],
  "properties": {
    "case_family": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "logical",
        "metaphysical",
        "moral",
        "historical",
        "transmission",
        "phenomenological",
        "authority"
      ]
    },
    "claim_level": {
      "type": "string",
      "default": "first-order",
      "enum": [
        "first-order",
        "meta-epistemic",
        "meta-ontological",
        "meta-noetic",
        "cross-level"
      ]
    },
    "pattern_profile": {
      "type": "string",
      "pattern": "^(PF-(?:[1-9]|1[0-2])|none)$"
    },
    "deformation": {
      "type": "string",
      "minLength": 1
    },
    "concealment_mode": {
      "type": "string",
      "enum": [
        "clear",
        "irad",
        "juhud",
        "inkar",
        "istikbar",
        "nifaq",
        "mode-?",
        "compound"
      ]
    },
    "do_orient": {
      "type": "string",
      "enum": [
        "truth-seek",
        "identity-perf",
        "autotelic",
        "zann-mode",
        "mixed"
      ]
    },
    "reason_category": {
      "oneOf": [
        {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        {
          "type": "string",
          "enum": ["1", "2", "3", "4"]
        }
      ]
    },
    "routing_gate": {
      "type": "string",
      "enum": [
        "open",
        "V2-required",
        "deformation-first",
        "semantic-discipline-required",
        "register-hold",
        "stop-condition"
      ]
    },
    "gate_trigger": {
      "type": "string",
      "description": "Identifies which of the six dispatch gate checks fired and blocked module activation. Format: 'check [1-6] — [rule id or stop id]', e.g. 'check 3 — S-2' or 'check 4 — Stop-2'. Omit when routing_gate is 'open'.",
      "minLength": 1
    },
    "matched_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module_class"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module_class": {
            "type": "string",
            "enum": ["case-library", "tactic", "procedure", "technique", "diagnostic"]
          }
        }
      }
    },
    "restoration_target": {
      "type": "string",
      "minLength": 1
    },
    "reconstruction_fidelity": {
      "type": "string",
      "enum": ["pass", "partial", "fail"],
      "description": "Reconstruction verdict from original input plus populated IR/trace candidate. Optional for legacy artifacts; required by the reconstruction pass before ordinary dispatch."
    },
    "reconstructor_notes": {
      "type": "string",
      "minLength": 1,
      "description": "Brief note naming what could not be recovered when reconstruction_fidelity is partial/fail, or compact neighbor contrast when present on pass."
    },
    "structural_pattern_print": {
      "type": "string",
      "description": "Optional compact local description of the active structural pattern when PF code alone is too coarse to preserve practical framing. It is subordinate to claim_level, pattern_profile, and routing precedence.",
      "minLength": 1
    },
    "load_bearing_node": {
      "type": "string",
      "description": "Optional criterion, authority rule, semantic hinge, category-set, or noetic blocker currently carrying the pressure.",
      "minLength": 1
    },
    "collapse_radius": {
      "type": "string",
      "description": "Optional downstream claims, routes, or held content whose status depends on clearing the load-bearing node.",
      "minLength": 1
    },
    "intervention_target": {
      "type": "string",
      "description": "Optional bounded operation that clears the load-bearing node before downstream content can release.",
      "minLength": 1
    },
    "framing_notes": {
      "type": "string",
      "description": "Optional internal renderer constraint that prevents argument-bank, citation-dump, or wrong-family release behavior. Not public boilerplate.",
      "minLength": 1
    },
    "next_move": {
      "type": "string",
      "minLength": 1
    },
    "ns_code": {
      "type": "string"
    },
    "rt_marker": {
      "type": "string",
      "enum": ["RT-1", "RT-2", "RT-3", "RT-4", "none"]
    },
    "read_status": {
      "type": "string",
      "enum": ["dominant", "distributed", "underdetermined"]
    },
    "confidence": {
      "type": "string",
      "enum": ["strong", "provisional", "low"]
    },
    "decisive_missing_differentiator": {
      "type": "string",
      "minLength": 1,
      "description": "Conditional-mandatory when confidence is not strong or read_status is not dominant; names the signal that would refine, falsify, or collapse the remaining ambiguity."
    },
    "alignment_state": {
      "type": "string",
      "enum": [
        "blocked",
        "tribunal-loosened",
        "frame-cleared",
        "recognition-surfaced",
        "alignment-advanced"
      ]
    },
    "recognition_strength": {
      "type": "string",
      "enum": ["none", "weak", "medium", "strong"]
    },
    "continuation_eligibility": {
      "type": "string",
      "enum": ["not-assessed", "blocked", "eligible-on-refresh"]
    },
    "p7_stops_active": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "none"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Stop-1", "Stop-2", "Stop-3", "Stop-4", "Stop-5"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "prohibited_moves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backbone_predicates_active": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["C-1", "C-2", "C-3", "T-1", "T-2", "T-3", "O-1", "O-2", "O-3", "K-1", "K-2"]
      },
      "uniqueItems": true
    },
    "foreign_premise": {
      "type": "string"
    },
    "upstream_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "criterion-import",
          "tribunal-installation",
          "transmission-demotion",
          "semantic-neutralization-recontenting",
          "semantic-neutralization-evacuation",
          "lexical-ontological-trap"
        ]
      },
      "uniqueItems": true
    },
    "philosophical_usurpation": {
      "type": "string"
    },
    "architectural_layer_disrupted": {
      "type": "string",
      "enum": [
        "fitrah",
        "sound-reason",
        "authentic-transmission",
        "inferential-route",
        "transcendence-immanence",
        "prophetic-authority",
        "none"
      ]
    },
    "ontological_disorder": {
      "type": "string",
      "enum": [
        "category-mistake",
        "illicit-analogy",
        "equivocal-predication",
        "composition-panic",
        "person-multiplicity-conflation",
        "perfect-being-usurpation",
        "none"
      ]
    },
    "source_basis": {
      "$comment": "source_basis is schema-optional for bare schema compatibility, but checker-mandatory whenever matched_modules is present. The executable enforcement lives in tools/check_ir_instance_integrity.py.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis_type", "claim", "source_kind"],
            "properties": {
              "basis_type": {
                "type": "string",
                "enum": ["anchored", "inference", "speculative", "synthesis"]
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "source_kind": {
                "type": "string",
                "enum": ["input", "module", "schema", "catalogue", "operator"]
              },
              "module_id": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source_kind": {
                      "const": "module"
                    }
                  },
                  "required": ["source_kind"]
                },
                "then": {
                  "required": ["module_id"]
                }
              },
              {
                "if": {
                  "properties": {
                    "basis_type": {
                      "enum": ["anchored", "inference", "speculative"]
                    }
                  },
                  "required": ["basis_type"]
                },
                "then": {
                  "required": ["source_ref"]
                }
              }
            ]
          }
        }
      }
    },
    "field_witness": {
      "$comment": "Optional schema-light trace sidecar. It is validated when present, does not replace post_render_gate, and does not imply full formal-calculus proof, truth, warrant, or interlocutor uptake.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_gradient",
        "burden_events",
        "field_diagnostics",
        "loopbreak",
        "reconstruction",
        "closure",
        "transfer_boundary",
        "register_deltas",
        "non_claims",
        "provenance",
        "coverage_proof"
      ],
      "properties": {
        "route_gradient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible_routes", "selected", "reason"],
          "properties": {
            "eligible_routes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "selected": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "burden_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "delta_nB", "delta_kappa", "result"],
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "delta_nB": { "type": "string", "minLength": 1 },
              "delta_kappa": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "minLength": 1 }
            }
          }
        },
        "field_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["divergence", "curl"],
          "properties": {
            "divergence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "status"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 }
              }
            },
            "curl": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "status"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "loopbreak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licensed", "target", "ground", "delta_effect", "post_break_reread"],
          "properties": {
            "licensed": { "type": "boolean" },
            "target": { "type": "string" },
            "ground": { "type": "string" },
            "delta_effect": { "type": "string" },
            "post_break_reread": { "type": "string" }
          }
        },
        "reconstruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["held_set", "live_remainder", "reread_scope"],
          "properties": {
            "held_set": {
              "type": "array",
              "items": { "type": "string" }
            },
            "live_remainder": {
              "type": "array",
              "items": { "type": "string" }
            },
            "reread_scope": { "type": "string", "minLength": 1 }
          }
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "decision", "agent_field_status"],
          "properties": {
            "operator": { "type": "string", "const": "𝒞(Ψᴺ)" },
            "decision": {
              "type": "string",
              "enum": ["COMPLETE", "STOP", "HOLD", "RECURSE", "PARTIAL"]
            },
            "agent_field_status": { "type": "string", "minLength": 1 }
          }
        },
        "transfer_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "from", "to", "mode"],
          "properties": {
            "operator": { "type": "string", "const": "T_lang" },
            "from": { "type": "string", "const": "Ψᴺ" },
            "to": { "type": "string", "const": "Ψᴵ" },
            "mode": { "type": "string", "const": "coupling-attempt" }
          }
        },
        "register_deltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["register", "delta"],
            "properties": {
              "register": { "type": "string", "minLength": 1 },
              "delta": { "type": "string", "minLength": 1 }
            }
          }
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_type", "source", "captured_by"],
          "properties": {
            "evidence_type": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "captured_by": { "type": "string", "minLength": 1 }
          }
        },
        "reread_pressure": {
          "$comment": "Optional TTP-MRP evidence. It records how the post-landed reread state was pressured before STOP/HOLD/RECURSE/LoopBreak/closure.",
          "type": "object",
          "additionalProperties": false,
          "required": ["target_burden_id", "reread_delta", "pressure_activations", "route_gradient", "divergence_state", "curl_state", "finding", "route_result_type", "graph_delta", "preemption_basis", "route", "non_claims"],
          "properties": {
            "target_burden_id": { "type": "string", "pattern": "^B[0-9]+$" },
            "reread_delta": { "type": "string", "minLength": 1 },
            "route_gradient": {
              "type": "string",
              "minLength": 1,
              "description": "Plain-∇ directional reread after Land(ⁿB): held target, generated target, HOLD, LoopBreak, or STOP."
            },
            "pressure_activations": {
              "type": "object",
              "additionalProperties": false,
              "required": ["freeze_landed_move", "dependency_tug", "hidden_framework_recoil", "entailment_pressure", "doubt_churn_guard", "reorientation_reminder"],
              "properties": {
                "freeze_landed_move": { "type": "string", "minLength": 1 },
                "dependency_tug": { "type": "string", "minLength": 1 },
                "hidden_framework_recoil": { "type": "string", "minLength": 1 },
                "entailment_pressure": { "type": "string", "minLength": 1 },
                "doubt_churn_guard": { "type": "string", "minLength": 1 },
                "reorientation_reminder": { "type": "string", "minLength": 1 }
              }
            },
            "finding": {
              "type": "string",
              "enum": ["stable", "genuine-dependent", "partial-real", "hidden-framework-recoil", "doubt-churn", "reorientation"]
            },
            "route_result_type": {
              "type": "string",
              "enum": ["held_burden_activation", "generated_burden_instantiation", "no_new_resultant", "loopbreak", "hold_partial"]
            },
            "divergence_state": {
              "type": "string",
              "enum": ["neutral", "settled", "bounded", "non-neutral"]
            },
            "curl_state": {
              "type": "string",
              "enum": ["null", "resolved", "held", "non-null"]
            },
            "graph_delta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes_added", "edges_added", "note"],
              "properties": {
                "nodes_added": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^B[0-9]+$" },
                  "uniqueItems": true
                },
                "edges_added": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["from", "to"],
                    "properties": {
                      "from": { "type": "string", "pattern": "^B[0-9]+$" },
                      "to": { "type": "string", "pattern": "^B[0-9]+$" }
                    }
                  }
                },
                "note": { "type": "string", "minLength": 1 }
              }
            },
            "preemption_basis": {
              "type": "string",
              "enum": ["none", "graph-bound", "commitment-bound", "framework-bound"]
            },
            "route": {
              "type": "string",
              "enum": ["STOP", "HOLD", "RECURSE", "LoopBreak(∇×T)"]
            },
            "non_claims": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coverage_proof": {
          "$comment": "Schema-light collapse reconstruction for field_witness. Coverage proves rendered accounting, not live noetic competence.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_burden_set",
            "terminal_states",
            "dependency_graph",
            "divergence_check",
            "curl_check",
            "coverage_complete"
          ],
          "properties": {
            "initial_burden_set": {
              "type": "array",
              "items": { "type": "string", "pattern": "^B[0-9]+$" },
              "uniqueItems": true
            },
            "terminal_states": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state"],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "landed",
                      "discharged-as-derivative",
                      "held-with-reason",
                      "carried-PARTIAL",
                      "carried-RECURSE",
                      "cleared"
                    ]
                  },
                  "operator": { "type": "string" },
                  "delta_nB": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            },
            "dependency_graph": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "edges", "roots", "parallel_groups", "acyclic"],
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^B[0-9]+$" },
                  "uniqueItems": true
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["from", "to"],
                    "properties": {
                      "from": { "type": "string", "pattern": "^B[0-9]+$" },
                      "to": { "type": "string", "pattern": "^B[0-9]+$" }
                    }
                  }
                },
                "roots": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^B[0-9]+$" },
                  "uniqueItems": true
                },
                "parallel_groups": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "string", "pattern": "^B[0-9]+$" },
                    "uniqueItems": true
                  }
                },
                "acyclic": { "type": "boolean" }
              }
            },
            "divergence_check": { "type": "string" },
            "curl_check": { "type": "string" },
            "coverage_complete": { "type": "boolean" }
          }
        }
      }
    },
    "inference_boundary_active": {
      "type": "string",
      "enum": ["yes", "no"]
    },
    "output_shape": {
      "type": "string",
      "enum": [
        "content",
        "relational",
        "maieutic",
        "invitational",
        "single-response",
        "held-pending"
      ]
    },
    "what_is_withheld_and_why": {
      "type": "string"
    },
    "what_remains_live": {
      "type": "string"
    },
    "post_render_gate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mandatory post-render state re-read / re-entry gate. It must run after every bounded restorative move and before any STOP decision.",
      "required": [
        "cleared_this_pass",
        "remaining_live_distortions",
        "held_routes_rechecked",
        "newly_released_routes",
        "next_eligible_pass",
        "recursion_decision"
      ],
      "properties": {
        "cleared_this_pass": {
          "type": "string",
          "minLength": 1
        },
        "remaining_live_distortions": {
          "type": "string",
          "minLength": 1
        },
        "held_routes_rechecked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "newly_released_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_eligible_pass": {
          "type": "string",
          "minLength": 1
        },
        "recursion_decision": {
          "type": "string",
          "enum": ["STOP", "HOLD", "RECURSE", "PARTIAL"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "read_status": {
            "const": "underdetermined"
          },
          "confidence": {
            "const": "strong"
          }
        },
        "required": ["read_status", "confidence"]
      },
      "then": false
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "not": {
              "const": "strong"
            }
          }
        },
        "required": ["confidence"]
      },
      "then": {
        "required": ["decisive_missing_differentiator"]
      }
    },
    {
      "if": {
        "properties": {
          "read_status": {
            "not": {
              "const": "dominant"
            }
          }
        },
        "required": ["read_status"]
      },
      "then": {
        "required": ["decisive_missing_differentiator"]
      }
    },
    {
      "if": {
        "properties": {
          "matched_modules": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["matched_modules"]
      },
      "then": {
        "required": ["source_basis"]
      }
    },
    {
      "if": {
        "properties": {
          "reconstruction_fidelity": {
            "enum": ["partial", "fail"]
          }
        },
        "required": ["reconstruction_fidelity"]
      },
      "then": {
        "required": ["reconstructor_notes"]
      }
    },
    {
      "if": {
