{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/field-witness-envelope.schema.json",
  "title": "DAEE Stage08 field witness audit envelope",
  "description": "Audit, coverage, reconstruction, and hash-binding envelope. It is not the public graph and structural PASS is not semantic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_gradient", "burden_events", "field_diagnostics", "loopbreak", "reconstruction", "closure", "transfer_boundary", "register_deltas", "non_claims", "provenance", "coverage_proof", "artifact_binding"],
  "properties": {
    "schema_version": {"const": "field-witness-envelope-v1"},
    "route_gradient": {"type": "object", "minProperties": 1},
    "burden_events": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "field_diagnostics": {"type": "object", "minProperties": 1},
    "loopbreak": {"type": ["object", "null"]},
    "reconstruction": {"type": "object", "minProperties": 1},
    "closure": {"type": "object", "minProperties": 1},
    "transfer_boundary": {"type": "object", "minProperties": 1},
    "register_deltas": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "minProperties": 1},
    "coverage_proof": {"type": "object", "minProperties": 1},
    "reread_pressure": {"type": "object"},
    "normalized_activation_record": {"type": "object"},
    "canonical_ir_projection": {"type": "object"},
    "owner_activation_ordering": {"type": "object"},
    "artifact_binding": {"type": "object", "minProperties": 1}
  }
}
