{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/hard-smoke-manifest.schema.json",
  "title": "D.1 retained hard-smoke manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "generated_skill_sha",
    "release_provenance_status",
    "stop_condition",
    "validator_order",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "d1-hard-smoke-manifest-v1"
    },
    "corpus_id": {
      "const": "v0.4.3.0-rc4-surfaces"
    },
    "generated_skill_sha": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "release_provenance_status": {
      "const": "frozen"
    },
    "stop_condition": {
      "const": "stop_on_first_failing_validator"
    },
    "validator_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
