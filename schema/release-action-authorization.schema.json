{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/release-action-authorization.schema.json",
  "title": "DAEE locked release-package build authorization, claim, and terminal receipt",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "authorization_id",
        "action",
        "repository",
        "target_branch",
        "target_ref",
        "source_commit",
        "clean_tree_sha256",
        "version",
        "profile",
        "output_directory",
        "allowed_actions",
        "denied_actions",
        "reusable",
        "owner_identity",
        "writer_boundary_identity",
        "issued_at",
        "valid_not_before",
        "valid_not_after",
        "nonce",
        "revoked",
        "claim_locator",
        "action_receipt_locator",
        "expected_claim_predecessor_sha256",
        "terminal_claim",
        "non_claims"
      ],
      "properties": {
        "schema": {
          "const": "release-action-authorization-v1"
        },
        "kind": {
          "const": "release-action-authorization"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "action": {
          "const": "build-release-package"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "target_branch": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "clean_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": "v0.4.6.0"
        },
        "profile": {
          "const": "execution-mini"
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "build-release-package"
          }
        },
        "denied_actions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "commit",
              "force",
              "publish",
              "push",
              "release",
              "tag",
              "upload"
            ]
          }
        },
        "reusable": {
          "const": false
        },
        "owner_identity": {
          "type": "string",
          "minLength": 1
        },
        "writer_boundary_identity": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "valid_not_before": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "valid_not_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "revoked": {
          "const": false
        },
        "claim_locator": {
          "type": "string",
          "minLength": 1
        },
        "action_receipt_locator": {
          "type": "string",
          "minLength": 1
        },
        "expected_claim_predecessor_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_claim": {
          "const": false
        },
        "non_claims": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "claim_id",
        "authorization_sha256",
        "authorization_id",
        "nonce",
        "action",
        "claim_locator",
        "action_receipt_locator",
        "output_directory",
        "writer_boundary_identity",
        "claimed_at",
        "predecessor_record_sha256",
        "status",
        "terminal_claim"
      ],
      "properties": {
        "schema": {
          "const": "release-action-claim-v1"
        },
        "kind": {
          "const": "release-action-claim"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "action": {
          "const": "build-release-package"
        },
        "claim_locator": {
          "type": "string",
          "minLength": 1
        },
        "action_receipt_locator": {
          "type": "string",
          "minLength": 1
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "writer_boundary_identity": {
          "type": "string",
          "minLength": 1
        },
        "claimed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "predecessor_record_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "CLAIMED"
        },
        "terminal_claim": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "receipt_id",
        "claim_sha256",
        "authorization_sha256",
        "authorization_id",
        "nonce",
        "action",
        "result",
        "writer_boundary_identity",
        "finalized_at",
        "output_directory",
        "package_path",
        "package_sha256",
        "package_bytes",
        "terminal",
        "terminal_claim"
      ],
      "properties": {
        "schema": {
          "const": "release-action-receipt-v1"
        },
        "kind": {
          "const": "release-action-receipt"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claim_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "action": {
          "const": "build-release-package"
        },
        "result": {
          "enum": [
            "PASS",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "writer_boundary_identity": {
          "type": "string",
          "minLength": 1
        },
        "finalized_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "package_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "package_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "terminal": {
          "const": true
        },
        "terminal_claim": {
          "const": false
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result",
            "package_path",
            "package_sha256",
            "package_bytes"
          ],
          "properties": {
            "result": {
              "const": "PASS"
            },
            "package_path": {
              "type": "string",
              "minLength": 1
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "result",
            "package_path",
            "package_sha256",
            "package_bytes"
          ],
          "properties": {
            "result": {
              "enum": [
                "FAILED",
                "UNKNOWN"
              ]
            },
            "package_path": {
              "type": "null"
            },
            "package_sha256": {
              "type": "null"
            },
            "package_bytes": {
              "type": "null"
            }
          }
        }
      ]
    }
  ]
}
