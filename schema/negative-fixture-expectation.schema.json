{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/negative-fixture-expectation.schema.json",
  "title": "DAEE canonical right-reason negative fixture expectation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture",
    "kind",
    "expected_checker_id",
    "expected_exit_category",
    "expected_exit_code",
    "expected_earliest_stage",
    "expected_failure_class",
    "expected_failure_subcode",
    "expected_downstream_invalidated",
    "required_diagnostic_markers",
    "forbidden_artifacts",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "daee-negative-fixture-expectation-v1"
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "invalid-single-signature",
        "composite-historical"
      ]
    },
    "expected_checker_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "expected_exit_category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "expected_exit_code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "expected_earliest_stage": {
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "preflight",
        "control-plane",
        "candidate-package",
        "release-action"
      ]
    },
    "expected_failure_class": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "expected_failure_subcode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "expected_downstream_invalidated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_diagnostic_markers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
