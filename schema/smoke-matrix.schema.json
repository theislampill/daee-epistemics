{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/smoke-matrix.schema.json",
  "title": "DAEE five-smoke campaign control records",
  "oneOf": [
    {"$ref": "#/$defs/inputRegistry"},
    {"$ref": "#/$defs/candidateTransition"},
    {"$ref": "#/$defs/usageReservation"},
    {"$ref": "#/$defs/usageReceipt"},
    {"$ref": "#/$defs/usageRecovery"},
    {"$ref": "#/$defs/candidateRecord"},
    {"$ref": "#/$defs/candidateBuildAuthorization"},
    {"$ref": "#/$defs/candidateBuildClaim"},
    {"$ref": "#/$defs/candidateRecordBound"},
    {"$ref": "#/$defs/candidateReadinessMarker"},
    {"$ref": "#/$defs/matrixAuthorization"},
    {"$ref": "#/$defs/matrixAuthorizationClaim"},
    {"$ref": "#/$defs/reviewProtocol"},
    {"$ref": "#/$defs/cycleAttempt"},
    {"$ref": "#/$defs/authorizationCheck"},
    {"$ref": "#/$defs/usageHeadAudit"},
    {"$ref": "#/$defs/taintAudit"},
    {"$ref": "#/$defs/reviewGate"},
    {"$ref": "#/$defs/structuralCycle"},
    {"$ref": "#/$defs/producerOutcome"},
    {"$ref": "#/$defs/campaignControl"},
    {"$ref": "#/$defs/dispatchManifest"},
    {"$ref": "#/$defs/cycleObservation"},
    {"$ref": "#/$defs/cycleObservationFinalizer"},
    {"$ref": "#/$defs/evidenceExport"},
    {"$ref": "#/$defs/structuralVerdict"},
    {"$ref": "#/$defs/reviewedVerdict"}
  ],
  "$defs": {
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "directoryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "tree_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "measuredCost": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "value"],
      "properties": {
        "unit": {"const": "usd"},
        "value": {"type": "string", "pattern": "^(?:unknown|0|[1-9][0-9]*(?:\\.[0-9]+)?)$"}
      }
    },
    "structuralCaseRef": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "input_sha256", "handoff_record", "prompt_manifest", "state_capsules", "output", "capture_manifest", "promotion_verdict"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "handoff_record": {"$ref": "#/$defs/artifactRef"},
        "prompt_manifest": {"$ref": "#/$defs/artifactRef"},
        "state_capsules": {"$ref": "#/$defs/directoryRef"},
        "output": {"$ref": "#/$defs/artifactRef"},
        "capture_manifest": {"$ref": "#/$defs/artifactRef"},
        "promotion_verdict": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "base": {
      "type": "object",
      "required": ["schema", "kind"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"},
        "kind": {"type": "string"}
      }
    },
    "inputRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "matrix_id", "cases", "forbidden_case_fields"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"},
        "kind": {"const": "input-registry"},
        "matrix_id": {"type": "string", "minLength": 1},
        "cases": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["case_id", "input_path", "raw_bytes", "raw_sha256"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "input_path": {"type": "string", "minLength": 1},
              "raw_bytes": {"type": "integer", "minimum": 1},
              "raw_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
            }
          }
        },
        "forbidden_case_fields": {
          "const": ["expected_burdens", "expected_submoves", "expected_route", "expected_citations", "expected_answer", "expected_output_bytes"]
        }
      }
    },
    "candidateTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "candidate_id", "from_status", "claimed", "dispatch_count", "to_status"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-transition"},
        "candidate_id": {"type": "string", "minLength": 1},
        "from_status": {"enum": ["READY_UNUSED", "CONSUMED_NO_DISPATCH", "CONSUMED_OBSERVED", "CONSUMED_DISPATCH_UNKNOWN", "QUARANTINED"]},
        "claimed": {"type": "boolean"}, "dispatch_count": {"type": ["integer", "null"], "minimum": 0},
        "to_status": {"enum": ["READY_UNUSED", "CONSUMED_NO_DISPATCH", "CONSUMED_OBSERVED", "CONSUMED_DISPATCH_UNKNOWN"]},
        "unresolved_usage": {"type": "boolean"}
      }
    },
    "usageReservation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "cohort", "reserved_calls", "unresolved_usage"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "campaign-usage-reservation"},
        "cohort": {"enum": ["gpt-producer", "gpt-review", "paired-producer", "paired-review"]},
        "reserved_calls": {"type": "integer", "minimum": 1}, "unresolved_usage": {"type": "boolean"}
      }
    },
    "usageReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "lane", "reserved_invocations", "completed", "failed_after_dispatch", "cancelled_after_dispatch", "not_dispatched", "unknown", "reservation_status", "predecessor_usage_sequence", "resulting_usage_sequence", "predecessor_usage_head_sha256", "resulting_usage_head_sha256", "provider_metadata_status", "measured_cost"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "campaign-usage-receipt"},
        "lane": {"enum": ["producer", "cold-review"]}, "reserved_invocations": {"enum": [5, 10]},
        "completed": {"type": "integer", "minimum": 0}, "failed_after_dispatch": {"type": "integer", "minimum": 0},
        "cancelled_after_dispatch": {"type": "integer", "minimum": 0}, "not_dispatched": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}, "reservation_status": {"enum": ["SETTLED", "RESERVED", "ORPHANED"]},
        "predecessor_usage_sequence": {"type": "integer", "minimum": 0}, "resulting_usage_sequence": {"type": "integer", "minimum": 0},
        "predecessor_usage_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "resulting_usage_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_metadata_status": {"enum": ["RECORDED", "UNAVAILABLE"]}, "measured_cost": {"$ref": "#/$defs/measuredCost"},
        "producer_invocations_delta": {"type": "integer", "minimum": 0}, "cold_review_invocations_delta": {"type": "integer", "minimum": 0}
      }
    },
    "usageRecovery": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "reservation_sha256", "recovery_authorization_sha256", "claimed_candidate_status", "unknown", "resulting_usage_head_sha256", "reservation_reused"],
      "properties": {"schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "campaign-usage-recovery"}, "reservation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "recovery_authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "claimed_candidate_status": {"enum": ["CONSUMED_NO_DISPATCH", "CONSUMED_OBSERVED", "CONSUMED_DISPATCH_UNKNOWN"]}, "unknown": {"type": "integer", "minimum": 0}, "resulting_usage_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reservation_reused": {"const": false}}
    },
    "candidateRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "candidate_id", "status"],
      "properties": {"schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-package-record"}, "candidate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["READY_UNUSED", "QUARANTINED", "CONSUMED_NO_DISPATCH", "CONSUMED_OBSERVED", "CONSUMED_DISPATCH_UNKNOWN"]}, "authorization_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}, "claim_receipt_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}, "archive_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}, "extracted_tree_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}, "predecessor_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "root_creation": {"enum": ["CREATED", "FAILED"]}, "fallback_quarantine_path": {"type": ["string", "null"]}, "promotion_eligible": {"type": "boolean"}}
    },
    "candidateBuildAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "authorization_id", "action", "one_use", "issued_at", "expires_at", "branch", "ref", "source_commit", "source_commit_receipt", "ci_readback", "source_preflight", "package_profile", "candidate_id", "custody_root", "candidate_root", "claim_path", "archive_name", "max_archive_bytes", "max_extracted_bytes", "max_archive_entries", "input_registry", "validation_registry", "producer_registry", "escape_registry", "usage_writer", "review_protocol", "model_execution_authorized", "terminal_claim", "non_claims", "authorization_sha256"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-build-authorization"},
        "authorization_id": {"type": "string", "minLength": 1}, "action": {"const": "BUILD_EXECUTION_MINI_CANDIDATE"}, "one_use": {"const": true},
        "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "branch": {"type": "string", "minLength": 1}, "ref": {"type": "string", "pattern": "^refs/heads/.+"}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_commit_receipt": {"$ref": "#/$defs/artifactRef"}, "ci_readback": {"$ref": "#/$defs/artifactRef"}, "source_preflight": {"$ref": "#/$defs/artifactRef"},
        "package_profile": {"const": "execution-mini"}, "candidate_id": {"type": "string", "minLength": 1}, "custody_root": {"type": "string", "minLength": 1}, "candidate_root": {"type": "string", "minLength": 1}, "claim_path": {"type": "string", "minLength": 1},
        "archive_name": {"type": "string", "pattern": "^[^/\\\\]+\\.skill\\.zip$"}, "max_archive_bytes": {"type": "integer", "minimum": 1}, "max_extracted_bytes": {"type": "integer", "minimum": 1}, "max_archive_entries": {"type": "integer", "minimum": 1},
        "input_registry": {"$ref": "#/$defs/artifactRef"}, "validation_registry": {"$ref": "#/$defs/artifactRef"}, "producer_registry": {"$ref": "#/$defs/artifactRef"}, "escape_registry": {"$ref": "#/$defs/artifactRef"}, "usage_writer": {"$ref": "#/$defs/artifactRef"}, "review_protocol": {"$ref": "#/$defs/artifactRef"},
        "model_execution_authorized": {"const": false}, "terminal_claim": {"const": false},
        "non_claims": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidateBuildClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "claim_id", "authorization_id", "authorization_sha256", "candidate_id", "claimed_at", "one_use", "terminal_claim", "claim_sha256"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-build-claim"}, "claim_id": {"type": "string", "minLength": 1},
        "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "candidate_id": {"type": "string", "minLength": 1},
        "claimed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "one_use": {"const": true}, "terminal_claim": {"const": false}, "claim_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidateRecordBound": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "candidate_id", "status", "branch", "ref", "source_commit", "source_commit_receipt", "ci_readback", "source_preflight", "package_profile", "archive", "extraction_receipt", "extracted_root", "tree_digest_algorithm", "extracted_tree_sha256", "extracted_file_count", "build_manifest", "skill_root", "compiled_module_map", "cold_law_manifest", "input_registry", "validation_registry", "producer_registry", "escape_registry", "usage_writer", "review_protocol", "custody_root", "candidate_root", "readiness_marker_path", "build_authorization", "build_claim", "build_authorization_sha256", "build_claim_sha256", "claim_status", "promotion_eligible", "model_execution_authorized", "invalidation_conditions", "non_claims", "record_sha256"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-package-record-bound"}, "candidate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["READY_UNUSED", "QUARANTINED", "CONSUMED_NO_DISPATCH", "CONSUMED_OBSERVED", "CONSUMED_DISPATCH_UNKNOWN"]},
        "branch": {"type": "string", "minLength": 1}, "ref": {"type": "string", "pattern": "^refs/heads/.+"}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_commit_receipt": {"$ref": "#/$defs/artifactRef"}, "ci_readback": {"$ref": "#/$defs/artifactRef"}, "source_preflight": {"$ref": "#/$defs/artifactRef"}, "package_profile": {"const": "execution-mini"},
        "archive": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_count"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "byte_count": {"type": "integer", "minimum": 1}}},
        "extraction_receipt": {"$ref": "#/$defs/artifactRef"}, "extracted_root": {"type": "string", "minLength": 1}, "tree_digest_algorithm": {"const": "daee-tree-sha256-v1"}, "extracted_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "extracted_file_count": {"type": "integer", "minimum": 1},
        "build_manifest": {"$ref": "#/$defs/artifactRef"}, "skill_root": {"$ref": "#/$defs/artifactRef"}, "compiled_module_map": {"$ref": "#/$defs/artifactRef"}, "cold_law_manifest": {"$ref": "#/$defs/artifactRef"},
        "input_registry": {"$ref": "#/$defs/artifactRef"}, "validation_registry": {"$ref": "#/$defs/artifactRef"}, "producer_registry": {"$ref": "#/$defs/artifactRef"}, "escape_registry": {"$ref": "#/$defs/artifactRef"}, "usage_writer": {"$ref": "#/$defs/artifactRef"}, "review_protocol": {"$ref": "#/$defs/artifactRef"},
        "custody_root": {"type": "string", "minLength": 1}, "candidate_root": {"type": "string", "minLength": 1}, "readiness_marker_path": {"const": "candidate-readiness.json"}, "build_authorization": {"$ref": "#/$defs/artifactRef"}, "build_claim": {"$ref": "#/$defs/artifactRef"}, "build_authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "build_claim_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "claim_status": {"enum": ["UNCLAIMED", "CLAIMED"]}, "promotion_eligible": {"const": false}, "model_execution_authorized": {"const": false},
        "invalidation_conditions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "non_claims": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidateReadinessMarker": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "candidate_id", "candidate_root", "status", "record_sha256", "archive_sha256", "tree_digest_algorithm", "extracted_tree_sha256", "readback_status", "promotion_eligible", "model_execution_authorized", "terminal_claim", "non_claims", "marker_sha256"],
      "properties": {"schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "candidate-readiness-marker"}, "candidate_id": {"type": "string", "minLength": 1}, "candidate_root": {"type": "string", "minLength": 1}, "status": {"const": "READY_UNUSED"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "tree_digest_algorithm": {"const": "daee-tree-sha256-v1"}, "extracted_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "readback_status": {"const": "VERIFIED"}, "promotion_eligible": {"const": false}, "model_execution_authorized": {"const": false}, "terminal_claim": {"const": false}, "non_claims": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "marker_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "matrixAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "authorization_id", "action", "one_use", "execution_lane", "execution_mode", "test_only", "live_execution_authorized", "candidate_id", "candidate_record", "candidate_readiness", "candidate_maturity", "candidate_state_at_authorization", "candidate_claim_status_at_authorization", "source_commit", "branch", "source_commit_receipt", "source_preflight", "campaign_authorization", "campaign_authorization_sha256", "execution_tooling_manifest", "package_sha256", "package_tree_sha256", "tree_digest_algorithm", "candidate_package_root", "input_registry", "review_protocol", "case_inputs", "producer_model", "producer_reasoning_effort", "cold_review_model", "cold_review_reasoning_effort", "model_runner", "resolved_model", "adapter_version", "host_application_version", "codex_executable_sha256", "provider_settings", "cohort_size", "cohort_protocol", "case_ids", "cycle_id", "launch_not_before", "launch_not_after", "expected_campaign_usage_sequence", "expected_campaign_usage_head_sha256", "isolated_root_prefix", "usage_ledger_root", "authorization_claim_path", "candidate_claim_path", "observation_finalizer_path", "prompt_retention_root", "output_retention_root", "provider_receipt_root", "structural_evidence_root", "optional_opus_authorized", "paid_execution_authorized", "authorization_sha256"],
      "properties": {
        "schema": {"const": "daee-smoke-matrix-v1"}, "kind": {"const": "matrix-authorization"}, "authorization_id": {"type": "string", "minLength": 1}, "action": {"const": "RUN_REVIEWED_FIVE_SMOKE"}, "one_use": {"const": true},
        "execution_lane": {"const": "producer"}, "execution_mode": {"const": "LIVE_CODEX"}, "test_only": {"const": false}, "live_execution_authorized": {"const": true},
        "candidate_id": {"type": "string", "minLength": 1}, "candidate_record": {"$ref": "#/$defs/artifactRef"}, "candidate_readiness": {"$ref": "#/$defs/artifactRef"}, "candidate_maturity": {"$ref": "#/$defs/artifactRef"}, "candidate_state_at_authorization": {"const": "READY_UNUSED"}, "candidate_claim_status_at_authorization": {"const": "UNCLAIMED"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "branch": {"type": "string", "minLength": 1}, "source_commit_receipt": {"$ref": "#/$defs/artifactRef"}, "source_preflight": {"$ref": "#/$defs/artifactRef"}, "campaign_authorization": {"$ref": "#/$defs/artifactRef"}, "campaign_authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "execution_tooling_manifest": {"$ref": "#/$defs/artifactRef"},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "package_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "tree_digest_algorithm": {"const": "daee-tree-sha256-v1"}, "candidate_package_root": {"type": "string", "minLength": 1},
        "input_registry": {"$ref": "#/$defs/artifactRef"}, "review_protocol": {"$ref": "#/$defs/artifactRef"},
        "case_inputs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "input_sha256"], "properties": {"case_id": {"type": "string", "minLength": 1}, "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
        "producer_model": {"const": "gpt-5.5"}, "producer_reasoning_effort": {"const": "high"}, "cold_review_model": {"const": "gpt-5.6-sol"}, "cold_review_reasoning_effort": {"const": "xhigh"}, "model_runner": {"const": "codex"}, "resolved_model": {"const": "gpt-5.5"}, "adapter_version": {"const": "codex-live-v1"}, "host_application_version": {"type": "string", "minLength": 1}, "codex_executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_settings": {"type": "object", "additionalProperties": false, "required": ["response_surface", "delivery_mode", "effective_context_limit_bytes", "command_timeout_seconds", "parallelism", "fresh_context_per_case", "submit_before_observe", "sandbox", "approval_policy", "ignore_user_config", "ignore_rules", "ephemeral"], "properties": {"response_surface": {"const": "package-faithful"}, "delivery_mode": {"const": "explicit-prompt-components"}, "effective_context_limit_bytes": {"type": "integer", "minimum": 1}, "command_timeout_seconds": {"type": "integer", "minimum": 1}, "parallelism": {"const": 5}, "fresh_context_per_case": {"const": true}, "submit_before_observe": {"const": true}, "sandbox": {"const": "read-only"}, "approval_policy": {"const": "never"}, "ignore_user_config": {"const": true}, "ignore_rules": {"const": true}, "ephemeral": {"const": true}}},
        "cohort_size": {"const": 5}, "cohort_protocol": {"const": "barrier-five-submit-before-await-v1"}, "case_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "cycle_id": {"type": "string", "minLength": 1},
        "launch_not_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "launch_not_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "expected_campaign_usage_sequence": {"type": "integer", "minimum": 0}, "expected_campaign_usage_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
