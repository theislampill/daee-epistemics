{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawah.wiki/schema/producer-capture-complete.schema.json",
  "title": "DAEE producer capture complete per-case binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "candidate_id", "source_commit", "cycle_id", "case_id", "envelope_nonce", "candidate_binding", "input_binding", "refs", "non_claims"],
  "properties": {
    "schema": {"const": "daee-producer-capture-complete-v1"},
    "status": {"const": "PRODUCER_CAPTURE_COMPLETE"},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cycle_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "envelope_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "candidate_binding": {"$ref": "#/$defs/candidate_binding"},
    "input_binding": {"$ref": "#/$defs/input_binding"},
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_completion", "capture_evidence", "raw_input", "exact_prompt", "composite_runtime_context", "package_harness_parity", "raw_output", "execution_custody", "provider_receipt"],
      "properties": {
        "producer_completion": {"$ref": "#/$defs/artifact_ref"},
        "capture_evidence": {"$ref": "#/$defs/artifact_ref"},
        "raw_input": {"$ref": "#/$defs/artifact_ref"},
        "exact_prompt": {"$ref": "#/$defs/artifact_ref"},
        "composite_runtime_context": {"$ref": "#/$defs/artifact_ref"},
        "package_harness_parity": {"$ref": "#/$defs/artifact_ref"},
        "raw_output": {"$ref": "#/$defs/artifact_ref"},
        "execution_custody": {"$ref": "#/$defs/artifact_ref"},
        "provider_receipt": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "non_claims": {
      "const": [
        "capture completion is not structural finalization",
        "structural finalization is not campaign success or semantic review"
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_commit", "candidate_record_sha256", "candidate_maturity_sha256", "archive_sha256", "package_tree_sha256", "skill_sha256", "build_manifest_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_record_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_maturity_sha256": {"$ref": "#/$defs/sha256"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "package_tree_sha256": {"$ref": "#/$defs/sha256"},
        "skill_sha256": {"$ref": "#/$defs/sha256"},
        "build_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_count"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "producer_completion": {
      "type": "object",
      "required": ["schema", "status", "execution_mode", "test_only", "candidate_id", "cycle_id", "source_commit", "package_record_sha256", "candidate_maturity_sha256", "package_sha256", "package_tree_sha256", "results", "cold_review_authorized"],
      "properties": {
        "schema": {"const": "reviewed-campaign-producer-completion-v1"},
        "status": {"const": "PRODUCER_CAPTURE_COMPLETE"},
        "execution_mode": {"const": "LIVE_CODEX"},
        "test_only": {"const": false},
        "candidate_id": {"type": "string", "minLength": 1},
        "cycle_id": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_record_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_maturity_sha256": {"$ref": "#/$defs/sha256"},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "package_tree_sha256": {"$ref": "#/$defs/sha256"},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/completion_result"}},
        "cold_review_authorized": {"const": false}
      }
    },
    "completion_result": {
      "type": "object",
      "required": ["case_id", "capture_status", "structural_status", "output", "capture_evidence", "provider_receipt", "provider_receipt_sha256"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "capture_status": {"const": "CAPTURED"},
        "structural_status": {"const": "UNVERIFIED"},
        "output": {"$ref": "#/$defs/artifact_ref"},
        "capture_evidence": {"$ref": "#/$defs/artifact_ref"},
        "provider_receipt": {"$ref": "#/$defs/artifact_ref"},
        "provider_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capture_evidence": {
      "type": "object",
      "required": ["schema", "status", "candidate_id", "source_commit", "case_id", "prompt", "raw_input", "runtime_context", "package_harness_parity", "raw_output", "credential_residue_scan", "execution_custody_sha256", "execution_custody", "completion_identity", "structural_status"],
      "properties": {
        "schema": {"const": "reviewed-campaign-live-capture-v1"},
        "status": {"const": "CAPTURED"},
        "candidate_id": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "case_id": {"type": "string", "minLength": 1},
        "prompt": {"$ref": "#/$defs/artifact_ref"},
        "raw_input": {"$ref": "#/$defs/artifact_ref"},
        "runtime_context": {"$ref": "#/$defs/artifact_ref"},
        "package_harness_parity": {"$ref": "#/$defs/artifact_ref"},
        "raw_output": {"$ref": "#/$defs/artifact_ref"},
        "credential_residue_scan": {"$ref": "#/$defs/artifact_ref"},
        "execution_custody_sha256": {"$ref": "#/$defs/sha256"},
        "execution_custody": {"$ref": "#/$defs/artifact_ref"},
        "completion_identity": {"type": "object"},
        "structural_status": {"const": "UNVERIFIED"}
      }
    },
    "execution_custody": {
      "type": "object",
      "required": ["schema", "lane", "candidate_id", "source_commit", "cycle_or_review_batch_id", "case_id", "subject_id", "model", "reasoning_effort", "provider_settings", "execution_tooling_manifest", "single_call_output_contract", "capture_bindings"],
      "properties": {
        "schema": {"const": "reviewed-campaign-execution-custody-v1"},
        "lane": {"const": "producer"},
        "candidate_id": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cycle_or_review_batch_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "model": {"const": "gpt-5.5"},
        "reasoning_effort": {"const": "high"},
        "provider_settings": {
          "type": "object",
          "required": ["effective_context_limit_bytes", "command_timeout_seconds"],
          "properties": {
            "effective_context_limit_bytes": {"type": "integer", "minimum": 1},
            "command_timeout_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "execution_tooling_manifest": {"$ref": "#/$defs/artifact_ref"},
        "single_call_output_contract": {"type": "object"},
        "capture_bindings": {"type": "object"}
      }
    },
    "provider_receipt": {
      "type": "object",
      "required": ["call_id", "candidate_id", "cycle_or_review_batch_id", "case_id", "subject_id", "model", "reasoning_effort", "status", "terminal_transport_status", "provider_call_id", "usage", "cost"],
      "properties": {
        "call_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "cycle_or_review_batch_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "model": {"const": "gpt-5.5"},
        "reasoning_effort": {"const": "high"},
        "status": {"const": "COMPLETED"},
        "terminal_transport_status": {"const": "COMPLETED"},
        "provider_call_id": {"type": "string", "minLength": 1},
        "usage": {"type": "object"},
        "cost": {"type": "object"}
      }
    }
  }
}
