{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/field-witness.schema.json",
  "title": "DAEE current public trajectory graph",
  "description": "Canonical current public field_witness graph. Structural validity does not establish semantic truth, provenance, uptake, or release readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "B_LA", "B_MRP", "B_total", "nodes", "edges", "generated_burdens", "mrp_resultants", "reread_records", "formal_reread_states", "field_diagnostics", "terminal_states", "closure", "T_lang", "non_claims", "owner_activations", "owner_activation_ordering", "normalized_activation_record", "coverage_proof", "activation_lifecycle_fingerprint_sha256"],
  "properties": {
    "schema_version": {"const": "public-field-witness-v1"},
    "B_LA": {"$ref": "#/$defs/burden_ids"},
    "B_MRP": {"$ref": "#/$defs/burden_ids"},
    "B_total": {"$ref": "#/$defs/burden_ids"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "generated_burdens": {"type": "array", "items": {"$ref": "#/$defs/generated_burden"}},
    "mrp_resultants": {"type": "array", "items": {"$ref": "#/$defs/mrp_resultant"}},
    "reread_records": {"type": "array", "items": {"$ref": "#/$defs/reread"}},
    "formal_reread_states": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "field_diagnostics": {"type": "object", "additionalProperties": false, "required": ["divergence", "curl"], "properties": {"divergence": {"$ref": "#/$defs/diagnostic"}, "curl": {"$ref": "#/$defs/curl_diagnostic"}}},
    "terminal_states": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/terminal_state"}},
    "closure": {"$ref": "#/$defs/closure"},
    "T_lang": {"type": "object", "additionalProperties": false, "required": ["projection", "uptake_guaranteed", "boundary"], "properties": {"projection": {"const": "partial_coupling"}, "uptake_guaranteed": {"const": false}, "boundary": {"type": "string", "minLength": 1}}},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner_activations": {"type": "array", "items": {"$ref": "#/$defs/activation"}},
    "owner_activation_ordering": {"type": "object", "additionalProperties": false, "required": ["rows"], "properties": {"rows": {"type": "array", "items": {"$ref": "#/$defs/ordering_row"}}}},
    "normalized_activation_record": {"type": "object", "additionalProperties": false, "required": ["schema_version", "per_burden"], "properties": {"schema_version": {"const": "daee-nar-v2"}, "per_burden": {"type": "array", "items": {"$ref": "#/$defs/nar_burden"}}}},
    "coverage_proof": {"$ref": "#/$defs/coverage"},
    "activation_lifecycle_fingerprint_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "burden_id": {"type": "string", "pattern": "^B[1-9][0-9]*$"},
    "burden_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/burden_id"}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "type", "origin", "generation_depth", "lifecycle_status"], "properties": {"id": {"$ref": "#/$defs/burden_id"}, "type": {"enum": ["burden", "generated_burden"]}, "origin": {"enum": ["B_LA", "B_MRP"]}, "generation_depth": {"type": "integer", "minimum": 0}, "parent_id": {"anyOf": [{"$ref": "#/$defs/burden_id"}, {"type": "null"}]}, "lifecycle_status": {"type": "string", "minLength": 1}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to", "relation_class", "kind"], "properties": {"from": {"$ref": "#/$defs/burden_id"}, "to": {"$ref": "#/$defs/burden_id"}, "relation_class": {"const": "noetic_dependency"}, "kind": {"type": "string", "minLength": 1}}},
    "generated_burden": {"type": "object", "additionalProperties": false, "required": ["id", "source", "generation_depth", "event_id"], "properties": {"id": {"$ref": "#/$defs/burden_id"}, "source": {"$ref": "#/$defs/burden_id"}, "generation_depth": {"type": "integer", "minimum": 1}, "event_id": {"type": "string", "minLength": 1}}},
    "mrp_resultant": {"type": "object", "additionalProperties": false, "required": ["source", "target", "type", "route"], "properties": {"source": {"$ref": "#/$defs/burden_id"}, "target": {"$ref": "#/$defs/burden_id"}, "type": {"type": "string", "minLength": 1}, "route": {"type": "string", "minLength": 1}}},
    "reread": {"type": "object", "additionalProperties": false, "required": ["burden_id", "cycle_id", "route_result_type", "terminal_state"], "properties": {"burden_id": {"$ref": "#/$defs/burden_id"}, "cycle_id": {"type": "string", "minLength": 1}, "route_result_type": {"type": "string", "minLength": 1}, "terminal_state": {"type": "string", "minLength": 1}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["operator", "target", "status", "basis_refs", "delta_ref"], "properties": {"operator": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "basis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delta_ref": {"type": "string", "minLength": 1}}},
    "curl_diagnostic": {"type": "object", "additionalProperties": false, "required": ["operator", "target", "status", "basis_refs", "delta_ref", "cycle_refs", "loopbreak_ref"], "properties": {"operator": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "basis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delta_ref": {"type": "string", "minLength": 1}, "cycle_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "loopbreak_ref": {"type": ["string", "null"]}}},
    "terminal_state": {"type": "object", "additionalProperties": false, "required": ["state", "cycle_id"], "properties": {"state": {"type": "string", "minLength": 1}, "cycle_id": {"type": "string", "minLength": 1}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["opening_state", "derived_decision", "initial_coverage_complete", "lifecycle_accounting_complete", "collapse_positive", "closure_confirmed", "remaining_open_ids", "divergence", "curl", "loopbreak"], "properties": {"opening_state": {"const": "OPEN"}, "derived_decision": {"enum": ["RECURSE", "LOOPBREAK_REQUIRED", "HOLD", "PARTIAL", "CLOSURE_CANDIDATE", "COMPLETE"]}, "initial_coverage_complete": {"type": "boolean"}, "lifecycle_accounting_complete": {"type": "boolean"}, "collapse_positive": {"type": "boolean"}, "closure_confirmed": {"type": "boolean"}, "remaining_open_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "divergence": {"enum": ["unknown", "non-neutral", "bounded", "neutral"]}, "curl": {"enum": ["unknown", "non-null", "held", "resolved", "null"]}, "loopbreak": {"type": ["object", "null"]}}},
    "activation": {"type": "object", "additionalProperties": false, "required": ["ordinal", "body_ref", "burden_id", "owner_id", "operation", "resultant_sha256", "semantic_body_sha256"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "body_ref": {"type": "string", "minLength": 1}, "burden_id": {"$ref": "#/$defs/burden_id"}, "owner_id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "resultant_sha256": {"$ref": "#/$defs/sha256"}, "semantic_body_sha256": {"$ref": "#/$defs/sha256"}}},
    "ordering_row": {"type": "object", "additionalProperties": false, "required": ["ordinal", "body_ref", "ordering_role", "ordering_group"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "body_ref": {"type": "string", "minLength": 1}, "ordering_role": {"enum": ["required", "parallel", "contingent", "optional_non_load_bearing", "hold_partial"]}, "ordering_group": {"type": ["string", "null"]}}},
    "nar_burden": {"type": "object", "additionalProperties": false, "required": ["burden_id", "activation_ordinals", "cycle_id"], "properties": {"burden_id": {"$ref": "#/$defs/burden_id"}, "activation_ordinals": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "cycle_id": {"type": "string", "minLength": 1}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges", "roots"], "properties": {"nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}}}, "roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["initial_burden_set", "terminal_states", "dependency_graph", "provenance_event_dag", "divergence_check", "curl_check", "coverage_complete"], "properties": {"initial_burden_set": {"$ref": "#/$defs/burden_ids"}, "terminal_states": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}, "dependency_graph": {"$ref": "#/$defs/graph"}, "provenance_event_dag": {"$ref": "#/$defs/graph"}, "divergence_check": {"type": "string", "minLength": 1}, "curl_check": {"type": "string", "minLength": 1}, "coverage_complete": {"type": "boolean"}}}
  }
}
