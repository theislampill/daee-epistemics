{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawah.wiki/schema/execution-tooling-manifest.schema.json",
  "title": "DAEE Stage07 exact execution-tooling manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "source_commit", "source_tree", "profile", "membership", "result_order", "file_count", "aggregate_algorithm", "aggregate_sha256", "files"],
  "properties": {
    "schema": {"const": "daee-stage07-execution-tooling-manifest-v1"},
    "kind": {"const": "execution-tooling-manifest"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile": {"const": "stage07-release"},
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_roots", "runtime_resources"],
      "properties": {
        "snapshot_roots": {"const": ["tools", "schema"]},
        "runtime_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "result_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "file_count": {"type": "integer", "minimum": 1},
    "aggregate_algorithm": {"const": "sha256-domain-canonical-json-stage07-tooling-v1"},
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "git_mode", "blob_oid", "byte_count", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "git_mode": {"enum": ["100644", "100755"]},
          "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
