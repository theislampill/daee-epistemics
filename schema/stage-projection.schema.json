{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/stage-projection.schema.json",
  "title": "DAEE Stage04-Stage07 lossless activation and lifecycle projection",
  "description": "Closed structural projection contract. Hash equality and parity do not establish semantic truth or T_lang uptake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "stage04", "stage05", "stage06", "stage07", "non_claims"],
  "properties": {
    "schema_version": {"const": "daee-stage-projection-v1"},
    "projection_id": {"type": "string", "minLength": 1},
    "stage04": {"$ref": "#/$defs/stage04"},
    "stage05": {"$ref": "#/$defs/stage05"},
    "stage06": {"$ref": "#/$defs/stage06"},
    "stage07": {"$ref": "#/$defs/stage07"},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activation": {"type": "object", "additionalProperties": false, "required": ["ordinal", "obligation_id", "operation_capsule_id", "body_ref", "burden_id", "owner_id", "operation", "pressure_ids", "before_state_sha256", "performed_evidence_sha256", "resultant_sha256", "residual_sha256", "land_contribution_sha256", "semantic_body_sha256"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "obligation_id": {"type": "string", "minLength": 1}, "operation_capsule_id": {"type": "string", "minLength": 1}, "body_ref": {"type": "string", "minLength": 1}, "burden_id": {"type": "string", "pattern": "^B[1-9][0-9]*$"}, "owner_id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "pressure_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "before_state_sha256": {"$ref": "#/$defs/sha256"}, "performed_evidence_sha256": {"$ref": "#/$defs/sha256"}, "resultant_sha256": {"$ref": "#/$defs/sha256"}, "residual_sha256": {"$ref": "#/$defs/sha256"}, "land_contribution_sha256": {"$ref": "#/$defs/sha256"}, "semantic_body_sha256": {"$ref": "#/$defs/sha256"}}},
    "cycle": {"type": "object", "additionalProperties": false, "required": ["cycle_id", "burden_id", "origin", "generation_depth", "parent_cycle_id", "obligation_ids", "operation_capsule_ids", "lifecycle_status", "terminal_state", "land_sha256", "reread_sha256", "resultant_sha256"], "properties": {"cycle_id": {"type": "string", "minLength": 1}, "burden_id": {"type": "string", "pattern": "^B[1-9][0-9]*$"}, "origin": {"enum": ["B_LA", "B_MRP"]}, "generation_depth": {"type": "integer", "minimum": 0}, "parent_cycle_id": {"type": ["string", "null"]}, "obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "operation_capsule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "lifecycle_status": {"type": "string", "minLength": 1}, "terminal_state": {"type": "string", "minLength": 1}, "land_sha256": {"$ref": "#/$defs/sha256"}, "reread_sha256": {"$ref": "#/$defs/sha256"}, "resultant_sha256": {"$ref": "#/$defs/sha256"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["opening_state", "derived_decision", "initial_coverage_complete", "lifecycle_accounting_complete", "collapse_positive", "closure_confirmed", "remaining_open_ids", "divergence", "curl", "loopbreak"], "properties": {"opening_state": {"const": "OPEN"}, "derived_decision": {"enum": ["RECURSE", "LOOPBREAK_REQUIRED", "HOLD", "PARTIAL", "CLOSURE_CANDIDATE", "COMPLETE"]}, "initial_coverage_complete": {"type": "boolean"}, "lifecycle_accounting_complete": {"type": "boolean"}, "collapse_positive": {"type": "boolean"}, "closure_confirmed": {"type": "boolean"}, "remaining_open_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "divergence": {"type": "string", "minLength": 1}, "curl": {"type": "string", "minLength": 1}, "loopbreak": {"type": ["object", "null"]}}},
    "nar": {"type": "object", "additionalProperties": false, "required": ["schema_version", "per_activation", "per_burden"], "properties": {"schema_version": {"const": "daee-nar-v2"}, "per_activation": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ordinal", "obligation_id", "body_ref", "burden_id", "owner_id", "operation", "resultant_sha256"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "obligation_id": {"type": "string", "minLength": 1}, "body_ref": {"type": "string", "minLength": 1}, "burden_id": {"type": "string", "minLength": 1}, "owner_id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "resultant_sha256": {"$ref": "#/$defs/sha256"}}}}, "per_burden": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["burden_id", "cycle_id", "activation_ordinals"], "properties": {"burden_id": {"type": "string", "minLength": 1}, "cycle_id": {"type": "string", "minLength": 1}, "activation_ordinals": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}}}}},
    "stage04": {"type": "object", "additionalProperties": false, "required": ["activation_lifecycle_fingerprint_sha256", "activations"], "properties": {"activation_lifecycle_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "activations": {"type": "array", "items": {"$ref": "#/$defs/activation"}}}},
    "stage05": {"type": "object", "additionalProperties": false, "required": ["activation_lifecycle_fingerprint_sha256", "burden_cycles", "provenance_event_dag", "noetic_dependency_graph", "closure_projection"], "properties": {"activation_lifecycle_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "burden_cycles": {"type": "array", "items": {"$ref": "#/$defs/cycle"}}, "provenance_event_dag": {"type": "object", "minProperties": 1}, "noetic_dependency_graph": {"type": "object", "minProperties": 1}, "closure_projection": {"$ref": "#/$defs/closure"}}},
    "stage06": {"type": "object", "additionalProperties": false, "required": ["activation_lifecycle_fingerprint_sha256", "activations", "burden_cycles", "closure_projection", "normalized_activation_record"], "properties": {"activation_lifecycle_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "activations": {"type": "array", "items": {"$ref": "#/$defs/activation"}}, "burden_cycles": {"type": "array", "items": {"$ref": "#/$defs/cycle"}}, "closure_projection": {"$ref": "#/$defs/closure"}, "normalized_activation_record": {"$ref": "#/$defs/nar"}}},
    "stage07": {"type": "object", "additionalProperties": false, "required": ["activation_lifecycle_fingerprint_sha256", "activations", "burden_cycles", "closure_projection", "normalized_activation_record", "semantic_body_hashes", "T_lang"], "properties": {"activation_lifecycle_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "activations": {"type": "array", "items": {"$ref": "#/$defs/activation"}}, "burden_cycles": {"type": "array", "items": {"$ref": "#/$defs/cycle"}}, "closure_projection": {"$ref": "#/$defs/closure"}, "normalized_activation_record": {"$ref": "#/$defs/nar"}, "semantic_body_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}, "T_lang": {"type": "object", "additionalProperties": false, "required": ["projection", "uptake_guaranteed", "boundary"], "properties": {"projection": {"const": "partial_coupling"}, "uptake_guaranteed": {"const": false}, "boundary": {"type": "string", "minLength": 1}}}}}
  }
}
