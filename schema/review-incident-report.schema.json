{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"DAEE review incident report","type":"object","additionalProperties":false,
  "required":["schema","incident_id","case_id","cycle_id","classified_attempt_id","raw_attempt","raw_output","packet","failure_class","substantive_grading_occurred","attempt_lineage","owner_notification","proposed_action","continuation_authority","basis"],
  "properties":{"schema":{"const":"daee-review-incident-report-v1"},"incident_id":{"type":"string","minLength":1},"case_id":{"type":"string","minLength":1},"cycle_id":{"type":"string","minLength":1},"classified_attempt_id":{"type":"string","minLength":1},"raw_attempt":{"$ref":"#/$defs/artifact"},"raw_output":{"$ref":"#/$defs/artifact"},"packet":{"$ref":"#/$defs/artifact"},"failure_class":{"enum":["reviewer_transport","delivery_corruption","packet_insufficiency","reviewer_policy_incompatibility","candidate_intelligibility","origin_unproven"]},"substantive_grading_occurred":{"type":"boolean"},"attempt_lineage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/artifact"}},"owner_notification":{"$ref":"#/$defs/notification"},"proposed_action":{"enum":["same-packet-retry","rebuild-packet","successor-candidate","stop"]},"continuation_authority":{"type":["object","null"]},"basis":{"type":"string","minLength":1}},
