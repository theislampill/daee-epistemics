{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theislampill.github.io/daee-epistemics/schema/andon-closure-ledger.schema.json",
  "title": "DAEE v0.4.6 ANDON closure ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_id",
    "source_head",
    "branch",
    "regression_status",
    "required_andon_ids",
    "overall_status",
    "owner_decision_controls",
    "rows",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "daee-andon-closure-ledger-v1"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "regression_status": {
      "enum": [
        "unproven",
        "not-comparable",
        "confounded",
        "candidate-observed",
        "replicated-candidate",
        "not-observed"
      ]
    },
    "required_andon_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^A(0[1-9]|1[0-6])$"
      },
      "uniqueItems": true
    },
    "overall_status": {
      "enum": [
        "OPEN",
        "IMPLEMENTED_UNVERIFIED",
        "VERIFIED_STRUCTURAL",
        "VERIFIED_SCOPED_MODEL",
        "HANDOFF",
        "BLOCKED",
        "DEFERRED",
        "CLOSED_OWNER_ACCEPTED"
      ]
    },
    "owner_decision_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "status",
          "decision",
          "binding_adr_id",
          "owner_source"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          },
          "status": {
            "const": "ACCEPTED"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "binding_adr_id": {
            "type": "string",
            "pattern": "^DAEE-ADR-046-[0-9]{3}$"
          },
          "owner_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "andon_id",
          "title",
          "priority",
          "status",
          "evidence_class",
          "code_lineage",
          "regression_status",
          "formal_chain_locations",
          "dependencies",
          "milestone_dependencies",
          "milestones",
          "owner_sources",
          "binding_adr_ids",
          "abnormality_evidence",
          "five_whys",
          "root_owner",
          "root_cause_id",
          "primary_andon_id",
          "affected_andon_ids",
          "shared_countermeasure_ref",
          "hansei",
          "implementation",
          "verification",
          "canaries",
          "rollback",
          "model_smoke_escape",
          "five_smoke_impact",
          "owner_gates",
          "artifact_gates",
          "remaining_risk",
          "next_action",
          "terminal_status"
        ],
        "properties": {
          "andon_id": {
            "type": "string",
            "pattern": "^A(0[1-9]|1[0-6])$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IMPLEMENTED_UNVERIFIED",
              "VERIFIED_STRUCTURAL",
              "VERIFIED_SCOPED_MODEL",
              "HANDOFF",
              "BLOCKED",
              "DEFERRED",
              "CLOSED_OWNER_ACCEPTED"
            ]
          },
          "evidence_class": {
            "enum": [
              "confirmed",
              "inferred",
              "unproven"
            ]
          },
          "code_lineage": {
            "enum": [
              "main-inherited",
              "pr8-hardening",
              "pr9-introduced",
              "cross-layer",
              "external-observation",
              "unproven"
            ]
          },
          "regression_status": {
            "enum": [
              "unproven",
              "not-comparable",
              "confounded",
              "candidate-observed",
              "replicated-candidate",
              "not-observed"
            ]
          },
          "formal_chain_locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A(0[1-9]|1[0-6])$"
            },
            "uniqueItems": true
          },
          "milestone_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "milestone_id",
                "status",
                "depends_on"
              ]
            }
          },
          "owner_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "binding_adr_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^DAEE-ADR-046-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "abnormality_evidence": {
            "type": "array",
            "minItems": 1
          },
          "five_whys": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "root_owner": {
            "type": "string",
            "minLength": 1
          },
          "root_cause_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_andon_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^A(0[1-9]|1[0-6])$"
              },
              {
                "type": "null"
              }
            ]
          },
          "affected_andon_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^A(0[1-9]|1[0-6])$"
            },
            "uniqueItems": true
          },
          "shared_countermeasure_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "hansei": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gap",
              "cause",
              "countermeasure",
              "follow_up_control"
            ],
            "properties": {
              "gap": {
                "type": "string",
                "minLength": 1
              },
              "cause": {
                "type": "string",
                "minLength": 1
              },
              "countermeasure": {
                "type": "string",
                "minLength": 1
              },
              "follow_up_control": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "files",
              "generated_files"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "generated_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "smoke_a",
              "smoke_b",
              "right_reason_negatives",
              "structural_only"
            ],
            "properties": {
              "smoke_a": {
                "type": "array",
                "minItems": 1
              },
              "smoke_b": {
                "type": "array",
                "minItems": 1
              },
              "right_reason_negatives": {
                "type": "array",
                "minItems": 1
              },
              "structural_only": {
                "type": "boolean"
              }
            }
          },
          "canaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "canary_id",
                "negative_fixture",
                "expected_stage",
                "expected_failure_class",
                "neighbor_valid_fixture",
                "mutation_operator",
                "status"
              ]
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "preserve",
              "command"
            ],
            "properties": {
              "strategy": {
                "type": "string",
                "minLength": 1
              },
              "preserve": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "model_smoke_escape": {
            "type": "object",
            "required": [
              "escape_id",
              "deterministic_detectability",
              "red_boundary_evidence",
              "green_boundary_evidence",
              "mutation_right_reason_evidence",
              "next_model_cycle_eligible",
              "recurrence_of_escape_id",
              "model_invocations_spent_before_detection",
              "estimated_model_invocations_avoided_by_canary"
            ]
          },
          "five_smoke_impact": {
            "type": "array"
          },
          "owner_gates": {
            "type": "array"
          },
          "artifact_gates": {
            "type": "array"
          },
          "remaining_risk": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "terminal_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_status",
              "owner_acceptance_required",
              "evidence_required"
            ],
            "properties": {
              "required_status": {
                "enum": [
                  "OPEN",
                  "IMPLEMENTED_UNVERIFIED",
                  "VERIFIED_STRUCTURAL",
                  "VERIFIED_SCOPED_MODEL",
                  "HANDOFF",
                  "BLOCKED",
                  "DEFERRED",
                  "CLOSED_OWNER_ACCEPTED"
                ]
              },
              "owner_acceptance_required": {
                "type": "boolean"
              },
              "evidence_required": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
