    "finding":{"type":"object","additionalProperties":false,"required":["finding_id","target_ids","severity","basis"],"properties":{"finding_id":{"type":"string","minLength":1},"target_ids":{"$ref":"#/$defs/ids"},"severity":{"enum":["material","nonmaterial"]},"basis":{"type":"string","minLength":1}}},
    "owner":{"type":"object","additionalProperties":false,"required":["material_reversal","patch_owner_involved","basis"],"properties":{"material_reversal":{"type":"boolean"},"patch_owner_involved":{"type":"boolean"},"basis":{"type":["string","null"]}}},
    "second":{"type":"object","additionalProperties":false,"required":["required","reason","review"],"properties":{"required":{"type":"boolean"},"reason":{"type":"string","minLength":1},"review":{"type":["object","null"]}}}
  }
