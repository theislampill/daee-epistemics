{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"DAEE accountable topology review","type":"object","additionalProperties":false,
  "required":["schema","review_id","case_id","cycle_id","input","artifacts","reviewer","reviewed_utc","structural_status","initial_assessment","cold_review_disclosure","cold_challenge_adjudications","findings","verdict","owner_adjudication","second_independent_review","non_claims"],
  "properties":{"schema":{"const":"daee-topology-review-v1"},"review_id":{"type":"string","minLength":1},"case_id":{"type":"string","minLength":1},"cycle_id":{"type":"string","minLength":1},"input":{"$ref":"#/$defs/artifact"},"artifacts":{"$ref":"#/$defs/artifacts"},"reviewer":{"$ref":"#/$defs/reviewer"},"reviewed_utc":{"type":"string","minLength":1},"structural_status":{"enum":["PASS","FAIL","PARTIAL"]},"initial_assessment":{"type":["object","null"]},"cold_review_disclosure":{"$ref":"#/$defs/disclosure"},"cold_challenge_adjudications":{"type":"array","items":{"$ref":"#/$defs/adjudication"}},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"verdict":{"enum":["PASS","FAIL","PARTIAL"]},"owner_adjudication":{"$ref":"#/$defs/owner"},"second_independent_review":{"$ref":"#/$defs/second"},"non_claims":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}},
