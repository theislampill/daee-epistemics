    "disclosure":{"type":"object","additionalProperties":false,"required":["cold_review","disclosed_utc","initial_assessment_sha256_at_disclosure"],"properties":{"cold_review":{"$ref":"#/$defs/artifact"},"disclosed_utc":{"type":"string","minLength":1},"initial_assessment_sha256_at_disclosure":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "targeted_artifact":{"type":"object","additionalProperties":false,"required":["path","sha256","byte_count","target_ids"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"byte_count":{"type":"integer","minimum":0},"target_ids":{"$ref":"#/$defs/ids"}}},
