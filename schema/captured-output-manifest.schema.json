{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"DAEE captured output custody manifest","type":"object","additionalProperties":false,
  "required":["schema","case_id","cycle_id","capture_id","input","runtime","execution","output","structural_replay","topology_review","cold_comprehensiveness_review","historical_provenance","non_claims"],
  "properties":{
    "schema":{"const":"daee-captured-output-v1"},"case_id":{"type":"string","minLength":1},"cycle_id":{"type":"string","minLength":1},"capture_id":{"type":"string","minLength":1},
    "input":{"$ref":"#/$defs/artifact"},"output":{"$ref":"#/$defs/artifact"},"topology_review":{"$ref":"#/$defs/artifact"},"cold_comprehensiveness_review":{"$ref":"#/$defs/artifact"},
    "runtime":{"$ref":"#/$defs/runtime"},"execution":{"$ref":"#/$defs/execution"},"structural_replay":{"$ref":"#/$defs/replay"},"historical_provenance":{"$ref":"#/$defs/provenance"},
    "non_claims":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "$defs":{
    "artifact":{"type":"object","additionalProperties":false,"required":["path","sha256","byte_count"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"byte_count":{"type":"integer","minimum":0}}},
    "runtime":{"type":"object","additionalProperties":false,"required":["version_label","source_commit","package","build_manifest","identity_source"],"properties":{"version_label":{"type":"string","minLength":1},"source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"package":{"$ref":"#/$defs/artifact"},"build_manifest":{"$ref":"#/$defs/artifact"},"identity_source":{"const":"external-custodian"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["operator","model_runner","model","host","session_id","started_utc","fresh_session","tool_policy","output_budget","retry_policy","continuation_policy","retry_count","continuation_count","truncated","invocation"],"properties":{"operator":{"type":"string","minLength":1},"model_runner":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"host":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"started_utc":{"type":"string","minLength":1},"fresh_session":{"type":"boolean"},"tool_policy":{"type":"string","minLength":1},"output_budget":{"type":"string","minLength":1},"retry_policy":{"type":"string","minLength":1},"continuation_policy":{"type":"string","minLength":1},"retry_count":{"type":"integer","minimum":0},"continuation_count":{"type":"integer","minimum":0},"truncated":{"type":"boolean"},"invocation":{"$ref":"#/$defs/artifact"}}},
    "checker":{"type":"object","additionalProperties":false,"required":["checker_id","command","checker_source","checker_source_sha256","exit_code","stdout","stderr","first_failure"],"properties":{"checker_id":{"type":"string","minLength":1},"command":{"type":"string","minLength":1},"checker_source":{"$ref":"#/$defs/artifact"},"checker_source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"exit_code":{"type":"integer","minimum":0,"maximum":255},"stdout":{"$ref":"#/$defs/artifact"},"stderr":{"$ref":"#/$defs/artifact"},"first_failure":{"type":"boolean"}}},
    "replay":{"type":"object","additionalProperties":false,"required":["verifier_commit","aggregate_status","first_failed_checker","checker_results","verdict"],"properties":{"verifier_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"aggregate_status":{"enum":["PASS","FAIL","NOT_RUN"]},"first_failed_checker":{"type":["string","null"]},"checker_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/checker"}},"verdict":{"$ref":"#/$defs/artifact"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["status","missing_fields","promotable"],"properties":{"status":{"enum":["complete","incomplete"]},"missing_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"promotable":{"type":"boolean"}}}
  }
}
